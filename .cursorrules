Step 5: Безопасность и Валидация (Firestore Security Rules)

Создай файл firestore.rules в корне проекта со следующим содержимым:
Фрагмент кода

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Вспомогательная функция проверки авторизации
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    match /clients/{clientId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /projects/{projectId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /tasks/{taskId} {
      allow read, write: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    match /leads/{leadId} {
      allow create: if true; // Публичное создание заявок с сайта
      allow read, update, delete: if isAuthenticated();
    }

    match /payments/{paymentId} {
      allow read, write: if isAuthenticated();
    }
  }
}

Step 6: Полировка UI/UX и адаптивность

